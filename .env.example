# Copy this file to .env and fill in real values
ENVIRONMENT=local
INTERNAL_API_KEY=change-me
JAVA_BACKEND_URL=http://localhost:8080/api/internal

# DeepSeek LLM
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=60

# Voyage embedding / rerank (for RAG)
VOYAGE_API_KEY=
VOYAGE_EMBED_BASE_URL=https://api.voyageai.com/v1
VOYAGE_EMBED_MODEL=voyage-3.5-lite
VOYAGE_EMBED_INPUT_TYPE=query

# Vnstock
VNSTOCK_API_KEY=

# FireAnt (optional, for company profile)
FIREANT_ACCESS_TOKEN=

# MySQL (export scripts only, not used by runtime API)
FINFLOW_DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Chat/RAG
CHAT_RAG_ENABLED=true
CHAT_QDRANT_URL=http://127.0.0.1:6333
CHAT_QDRANT_API_KEY=
CHAT_QDRANT_COLLECTION=annual_report_chunks_voyage_3_5_lite
CHAT_RAG_TOPK_VECTOR=50
CHAT_RAG_TOPK_KEYWORD=50
CHAT_RAG_RERANK_CANDIDATES=64
CHAT_RAG_TOPK_FINAL=5
CHAT_RAG_CONTEXT_MAX_CHARS=1800
VOYAGE_RERANK_URL=https://api.voyageai.com/v1/rerank
VOYAGE_RERANK_MODEL=rerank-2.5-lite
CHAT_FORECAST_ENABLED=true
CHAT_DEBUG_LOG_PROMPTS=false
