# Copy this file to .env and fill in real values
INTERNAL_API_KEY=
JAVA_BACKEND_URL=http://localhost:8080/api/internal

# DeepSeek LLM
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=60

# Local embedding (for RAG)
LOCAL_EMBEDDING_BASE_URL=http://127.0.0.1:9091/v1
LOCAL_EMBEDDING_API_KEY=no-key-required
LOCAL_EMBEDDING_MODEL=mlx-community/bge-m3-mlx-fp16

# Vnstock
VNSTOCK_API_KEY=

# FireAnt (optional, for company profile)
FIREANT_ACCESS_TOKEN=

# MySQL (export scripts only, not used by runtime API)
FINFLOW_DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Chat/RAG
CHAT_RAG_ENABLED=true
CHAT_QDRANT_URL=http://127.0.0.1:6333
CHAT_QDRANT_API_KEY=
CHAT_QDRANT_COLLECTION=annual_report_chunks_bge_m3
CHAT_FORECAST_ENABLED=true
CHAT_FORECAST_ON_DEMAND_ENABLED=true
CHAT_DEBUG_LOG_PROMPTS=false
